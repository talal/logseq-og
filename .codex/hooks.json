{
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "bb -m clojure-mcp-light.hook --cljfmt" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          { "type": "command", "command": "bb -m clojure-mcp-light.hook --cljfmt" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          { "type": "command", "command": "bb -m clojure-mcp-light.hook --cljfmt" }
        ]
      }
    ]
  }
}

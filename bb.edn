{:paths ["scripts/src" "src/main" "src/resources"]
 :deps
 {metosin/malli
  {:mvn/version "0.10.0"}
  logseq/bb-tasks
  {:local/root "deps/bb-tasks"}
  logseq/graph-parser
  {:local/root "deps/graph-parser"}
  io.github.bhauman/clojure-mcp-light
  {:git/url "https://github.com/bhauman/clojure-mcp-light"
   :git/tag "v0.2.2"
   :git/sha "c92841e7f16acd02311bc61f5c06dd42e95e1cb0"}
  org.clj-commons/digest
  {:mvn/version "1.4.100"}}
 :pods
 {clj-kondo/clj-kondo {:version "2026.07.24"}
  org.babashka/fswatcher {:version "0.0.3"}}
 :tasks
 {;; Development
  watch
  {:doc "Build assets and start the desktop asset and ClojureScript watchers"
   :depends [assets:build]
   :task logseq.tasks.dev.desktop/watch}

  electron-start
  {:doc "Open Electron using the watcher started by `bb watch`"
   :task logseq.tasks.dev.desktop/electron-start}

  ;; Validation and linting
  dev:validate-local-storage
  logseq.tasks.spec/validate-local-storage

  dev:validate-repo-config-edn
  logseq.tasks.malli/validate-repo-config-edn

  dev:validate-global-config-edn
  logseq.tasks.malli/validate-global-config-edn

  dev:validate-ast
  logseq.tasks.malli/validate-ast

  lint
  {:doc "Run all linter tasks"
   :depends [lint:clj-kondo lang:validate-translations]}

  dev:gen-malli-kondo-config
  logseq.tasks.dev/gen-malli-kondo-config

  nbb:watch
  logseq.bb-tasks.nbb.watch/watch

  nbb:portal-watch
  logseq.bb-tasks.nbb.watch/portal-watch

  lang:list
  logseq.tasks.lang/list-langs

  lang:missing
  logseq.tasks.lang/list-missing

  lang:validate-translations
  logseq.tasks.lang/validate-translations

;; Node asset steps used by ClojureScript builds
  assets:build
  {:doc "Build static resources, vendor assets, and production CSS"
   :task (shell "yarn gulp:build")}

  ;; ClojureScript commands
  clj-nrepl-eval
  {:task (apply shell "bb" "-m" "clojure-mcp-light.nrepl-eval" *command-line-args*)}

  clj-paren-repair
  {:doc "Repair and format Clojure delimiters"
   :task (apply shell "bb" "-m" "clojure-mcp-light.paren-repair" *command-line-args*)}

  cljs:watch-storybook
  {:doc "Watch the Storybook ClojureScript module"
   :task (shell "clojure -M:cljs watch stories-dev")}

  cljs:app-watch
  {:doc "Watch the browser ClojureScript build"
   :task (shell "clojure -M:cljs watch app")}

  cljs:release
  {:doc "Build the app and Electron ClojureScript releases"
   :task (shell "clojure -M:cljs release app electron")}

  cljs:release-electron
  {:doc "Build the Electron ClojureScript release"
   :task (shell "clojure -M:cljs release app electron --debug")}

  cljs:release-app
  {:doc "Build the production browser ClojureScript release"
   :task (shell "clojure -M:cljs release app --config-merge" "{:compiler-options {:output-feature-set :es6}}")}

  test:compile
  {:doc "Compile the ClojureScript test bundle"
   :task (shell "clojure -M:test compile test")}

  test:run
  {:doc "Run the compiled ClojureScript test bundle"
   :task (shell "node static/tests.js")}

  test
  {:doc "Compile and run the tests"
   :depends [test:compile test:run]}

  cljs:dev-release-app
  {:doc "Build the development browser release"
   :task (shell "clojure -M:cljs release app --config-merge" "{:closure-defines {frontend.config/DEV-RELEASE true}}")}

  cljs:dev-release-electron
  {:doc "Build development Electron release"
   :task (shell "clojure -M:cljs release app electron --debug --config-merge" "{:closure-defines {frontend.config/DEV-RELEASE true}}")}

  cljs:debug
  {:doc "Build the debug browser release"
   :task (shell "clojure -M:cljs release app --debug")}

  cljs:report
  {:doc "Generate a Shadow CLJS build report"
   :task (shell "clojure -M:cljs run shadow.cljs.build-report app report.html")}

  cljs:build-electron
  {:doc "Compile the app and Electron builds"
   :task (shell "clojure -M:cljs compile app electron")}

  lint:clj-kondo
  {:doc "Run clj-kondo over the ClojureScript source"
   :task (apply shell "clojure -M:clj-kondo --parallel --lint src" *command-line-args*)}

  fmt:check
  {:doc "Check Clojure and ClojureScript formatting"
   :task (shell "clojure -M:cljfmt check")}

  fmt
  {:doc "Format Clojure and ClojureScript code"
   :task (shell "clojure -M:cljfmt fix")}

  ;; Complete build and packaging workflows
  build:app
  {:doc "Build static assets and the production browser application"
   :depends [assets:build]
   :task (shell "clojure -M:cljs release app --config-merge" "{:compiler-options {:output-feature-set :es6}}")}

  build:dev-app
  {:doc "Build static assets and the development browser application"
   :depends [assets:build]
   :task (shell "clojure -M:cljs release app --config-merge" "{:closure-defines {frontend.config/DEV-RELEASE true}}")}

  build:release
  {:doc "Build static assets and all production ClojureScript targets"
   :depends [assets:build]
   :task (shell "clojure -M:cljs release app electron")}

  release:electron
  {:doc "Build and package the Electron application"
   :depends [assets:build cljs:release-electron]
   :task (shell "yarn electron:package")}}}
